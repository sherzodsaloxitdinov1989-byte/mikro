# Cloudflare Pages (va Netlify) uchun HTTP sarlavhalari
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-XW8LyM+OENkyfugRyQx7IM8YhqagA7yXrGHYu5asRjs='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://i.ytimg.com https://img.youtube.com https://i.vimeocdn.com; media-src 'self' blob: data:; connect-src 'self' blob: data:; frame-src 'self' blob: https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://docs.google.com https://www.canva.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/slides/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

/vendor/*
  Cache-Control: public, max-age=2592000

/vendor/pdfjs/*
  Content-Type: text/javascript; charset=utf-8

/vendor/qrcode/*
  Content-Type: text/javascript; charset=utf-8
