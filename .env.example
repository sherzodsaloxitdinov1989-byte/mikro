# Lokal ishga tushirish uchun namuna. Nusxasini .env nomi bilan saqlang.
# Cloudflare'da: Worker → Settings → Variables and Secrets (Secret); Netlify'da: Environment variables.

# Google Gemini API kaliti (bepul tarif): https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Ixtiyoriy: vergul bilan ajratilgan modellar zanjiri (birinchisi band bo'lsa, keyingisi ishlatiladi)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Claude API kaliti (pullik; o'rnatilsa Gemini o'rniga ishlatiladi) (https://console.anthropic.com). Kalit bo'lmasa AI tekshiruv taxminiy (qoidaga asoslangan) rejimda ishlaydi.
ANTHROPIC_API_KEY=
# Ixtiyoriy: model (standart: claude-opus-5-5). Tezroq javob uchun: claude-sonnet-5-5
ANTHROPIC_MODEL=
# Tokenlarni imzolash uchun uzun tasodifiy satr (Netlify'da MAJBURIY)
JWT_SECRET=
# O'qituvchi emaillari (vergul bilan): shu emaillar emailga kelgan kod bilan o'qituvchi bo'ladi (pochta kerak)
TEACHER_EMAILS=
# Ixtiyoriy zaxira: o'qituvchi sifatida ro'yxatdan o'tish uchun umumiy kod
TEACHER_CODE=

# Parolni tiklash kodi uchun pochta (Brevo — bepul, o'z domen shart emas; yoki RESEND_API_KEY)
BREVO_API_KEY=
RESEND_API_KEY=
# Brevo/Resend da tasdiqlangan yuboruvchi email va nom
MAIL_FROM=
MAIL_FROM_NAME=
# Faqat lokal sinov uchun: 1 bo'lsa xat yuborilmaydi, kod server logiga yoziladi
MAIL_DEBUG=
